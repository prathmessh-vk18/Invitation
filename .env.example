# Copy to .env.local (never commit it) and fill in from Supabase:
# Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / publishable key. Safe in the browser: the tables are locked to it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / secret key. Server only. Never expose it or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel login (/admin). Use a long password.
ADMIN_PASSWORD=
# Random string used to sign the admin login cookie, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# Where the site lives, used in links sent to couples.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
