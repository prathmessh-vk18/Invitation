{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "hnd1"
  ],
  "ignoreCommand": "[ -n \"$VERCEL_GIT_COMMIT_REF\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && exit 0; git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)*.md' ':(exclude)scripts' ':(exclude)supabase' ':(exclude)art-source'",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "30 21 * * *"
    }
  ]
}
